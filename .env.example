# Model provider for `cua discover` only. Replay needs none of this.
CUA_LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Operator console shared token. Any non-empty value for local use.
CUA_OPERATOR_TOKEN=change-me

# mockapp teller login. Synthetic credentials for the local target app only; defaults
# below match the code and need not be set unless you want different values.
MOCKAPP_LOGIN_USER=teller
MOCKAPP_LOGIN_PASSWORD=teller-demo-pw

# mockapp session budget: number of gated requests a session survives before it expires.
# Lower this for a fast, deterministic expiry demonstration.
MOCKAPP_SESSION_MAX_REQUESTS=20

# mockapp fault injection, app-wide default (overridden per request by ?fault=<name>).
# One of: not_found, denied, validation, expired, dialog, notice, slow, error_500.
MOCKAPP_FAULT=
